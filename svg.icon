DEFINE
	FUNCTION Svg.Icon = ( fillColour : STRING VAL ) =>
	VAR __URL = "data:image/svg+xml;utf8, "
	VAR __StartSVG = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 22 22'>"
	VAR __EndSVG = "</svg>"
	VAR __Box = "<rect width='20' height='20' x='1' y='1' rx='4' ry='4' fill='" & fillColour & "' />"
	RETURN
	__URL & __StartSVG & __Box & __EndSVG
	
