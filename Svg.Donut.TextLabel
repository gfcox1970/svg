DEFINE
	/// Returns a donut/progress ring SVG as a data URI
	/// @param {DECIMAL} percentValue - Progress value from 0 to 1 (e.g. 0.75)
	/// @param {STRING} outerColour   - Outer ring fill colour hex (e.g. "#DDDDDD")
	/// @param {STRING} innerColour   - Progress ring stroke colour hex (e.g. "#DC143C")
	/// @returns SVG data URI suitable for an Image URL category
	FUNCTION Svg.Donut.TextLabel = (percentValue: DECIMAL VAL, outerColour: STRING VAL, innerColour: STRING VAL) =>

		VAR __percentRaw = COALESCE(
			percentValue,
			0
		)
		VAR __Percent = MIN(
			1,
			MAX(
				0,
				__percentRaw
			)
		)

		// Ensure decimal separator is '.' for SVG calc(), and encode '#' for data URI safety
		VAR __PercentText = SUBSTITUTE(
			FORMAT(
				__Percent,
				"0.############"
			),
			",",
			"."
		)

		VAR __percentLabel = FORMAT(
			__Percent,
			"0.0%"
		)
		VAR __fontSize = FORMAT(
			10 * 0.25,
			"0"
		)

		VAR __centreText = "<text x='10' y='10' fill='#000000' font-family='Segoe UI Semibold' font-size='" & __fontSize & "' text-anchor='middle' dominant-baseline='middle'>" & __percentLabel & "</text>"

		VAR __dataURI = "data:image/svg+xml;utf8,"
		VAR __startSVG = "<svg height='30' width='30' xmlns='http://www.w3.org/2000/svg' viewBox='-5 -5 30 30'>"
		VAR __endSVG = "</svg>"

		VAR __outerCircle =
		"<circle r='10' cx='10' cy='10' fill='" & outerColour & "' stroke='" & innerColour & "' stroke-width='0.1' />"

		// r=5 => circumference ≈ 2*pi*r = 31.4
		VAR __innerCircle =
		"<circle r='5' cx='10' cy='10' fill='transparent' " & "stroke='" & innerColour & "' stroke-width='10' " & "stroke-dasharray='calc(" & __PercentText & " * 31.4) 31.4' " & "transform='rotate(-90) translate(-20)' />"

		VAR __circleHole = "<circle r='5' cx='10' cy='10' fill='#FFFFFF' stroke='" & innerColour & "' stroke-width='0.1'/>"

		RETURN
			__dataURI & __startSVG & __outerCircle & __innerCircle & __circleHole & __centreText & __endSVG
