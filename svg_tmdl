	/// Uses the dimColours dimension table to lookup a colour and percent value and return the corresponding HEX code
	/// @colourName {STRING} Name of the colour
	/// @percentValue {DECIMAL} The percent transparency
	/// @returns HEX code value as {STRING}
	function 'Get.Colour' =
			(
			        colourName   : STRING,
			        percentValue : DECIMAL
			    )
			    =>
				// colourName = The name of the colour used in calculation. Must be a STRING
				// percentValue = The value percent used in calculation. Must be a DECIMAL
			    VAR _Result = CALCULATE(
					SELECTEDVALUE( dimColours[HEX Code] ),
					dimColours[Colour Name] = colourName,
					dimColours[Percent] = percentValue
				)
				RETURN
					_Result
