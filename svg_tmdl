	/// Returns a progress bar SVG as a data URI
	/// @param {DECIMAL} percentValue - Progress value from 0 to 1 (e.g. 0.75)
	/// @param {STRING} barColour   - The hex colour code to show in the progress bar (e.g. "#DDDDDD")
	/// @returns SVG data URI suitable for an Image URL category
	function 'Svg.Progress' =
			(percentValue: DECIMAL VAL, barColour: STRING VAL) =>
					VAR __percent = VALUE(percentValue)
					VAR __barWidth = INT(100 * __percent)
					VAR __bar = IF(
						__barWidth < 10,
						12,
						__barWidth
					)
			
					// Use the function GET.COLOUR to return the required Balfour Beatty corporate colour and transparency value
					// Transparency any value between 0.1 and 1 in 0.1 steps
					// View the dimColours table for full list of possible colour names and transparency values
					// 1 = 100% solid colour, 0.1 = 10% transparency
			
					VAR __innerBarColour = GET.COLOUR(
						"lightgrey",
						0.2
					)
					VAR __lineColour = GET.COLOUR(
						"lightgrey",
						0.6
					)
			
					VAR __dataURI = "data:image/svg+xml;utf8, "
					VAR __startSVG = "<svg xmlns='http://www.w3.org/2000/svg' width='100' height='20'>"
					VAR __endSVG = "</svg>"
			
					VAR __outerBar = "<rect x='0' y='4' width='100' height='12' fill='" & __innerBarColour & "' stroke='" & __lineColour & "' rx='4' ry='4'  />"
					VAR __innerBar = "<rect x='0' y='4' width='" & __bar & "' height='12' fill='" & barColour & "' stroke='" & __lineColour & "' rx='4' ry='4'  />"
			
					RETURN
						__dataURI &
						SUBSTITUTE(
							__startSVG & __outerBar & __innerBar & __endSVG,
							"#",
							"%23" -- ensures URI-safe colour values
						)
		lineageTag: d3495e74-97e3-4b02-9f38-6800115d5b8d

