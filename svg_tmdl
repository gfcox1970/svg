	/// Returns a set of coloured dots SVG as a data URI
	/// @param {DECIMAL} percentValue - Progress value from 0 to 1 (e.g. 0.75)
	/// @returns SVG data URI suitable for an Image URL category
	function 'Svg.Dots' =
			(percentValue: DECIMAL VAL) =>
					VAR __percentValue = CEILING(
						percentValue * 10,
						1
					)
			
					// Use the function GET.COLOUR to return the required Balfour Beatty corporate colour and transparency value
					// Transparency any value between 0.1 and 1 in 0.1 steps
					// View the dimColours table for full list of possible colour names and transparency values
					// 1 = 100% solid colour, 0.1 = 10% transparency
			
					VAR __dotColour =
					SWITCH(
						TRUE(),
						percentValue >= 0.4, GET.COLOUR(
							"green",
							1
						),
						percentValue >= 0.3, GET.COLOUR(
							"yellow",
							1
						),
						GET.COLOUR(
							"red",
							1
						)
					)
			
					VAR __dataURI = "data:image/svg+xml;utf8,"
			
					VAR __startSVG =
					"<svg xmlns='http://www.w3.org/2000/svg' width='400' height='50'>"
			
					VAR __endSVG = "</svg>"
			
					VAR __dotSVG =
					CONCATENATEX(
						GENERATESERIES(
							1,
							10,
							1
						),
						"<circle cx='" & (([Value] - 1) * 40 + 20) &
						"' cy='20' r='14' fill='" &
						IF(
							[Value] <= __percentValue,
							__dotColour,
							GET.COLOUR(
								"lightgrey",
								0.4
							)
						) &
						"' stroke='#CCCCCC' />",
						"",
						[Value]
					)
			
					RETURN
						__dataURI &
						SUBSTITUTE(
							__startSVG & __dotSVG & __endSVG,
							"#",
							"%23" -- ensures URI-safe colour values
						)
		lineageTag: 520288aa-c118-4911-8d99-484adabff67d

	/// Returns a square SVG icon as a data URI
	/// @param {STRING} fillColour   - The hex colour of the icon (e.g. "#DC143C")
	/// @returns SVG data URI suitable for an Image URL category
	function 'Svg.Icon' =
			(fillColour: STRING VAL) =>
					VAR __dataURI = "data:image/svg+xml;utf8, "
					VAR __startSVG = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 22 22'>"
					VAR __endSVG = "</svg>"
					VAR __iconBox = "<rect width='20' height='20' x='1' y='1' rx='4' ry='4' fill='" & fillColour & "' />"
